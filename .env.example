# ============================================================
# .env.example — copy to .env and fill in your values
# ============================================================

# ---- Node Environment ----
NODE_ENV=development

# ---- JWT / Auth ----
JWT_SECRET=your_jwt_secret_key_here

# ---- Google OAuth (Auth Service + Frontend) ----
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# ---- NextAuth (Frontend) ----
NEXTAUTH_SECRET=your_nextauth_secret
NEXTAUTH_URL=http://localhost:3000

# ---- Service Ports ----
AUTH_SERVICE_PORT=3001
PRODUCT_SERVICE_PORT=3003
CART_SERVICE_PORT=3004
INVENTORY_SERVICE_PORT=3005
ORDER_SERVICE_PORT=3006
PAYMENT_SERVICE_PORT=3007
NOTIFICATION_SERVICE_PORT=3008

# ---- Service URLs (used by frontend) ----
AUTH_SERVICE_URL=http://auth-service:3001
PRODUCT_SERVICE_URL=http://product-service:3003
CART_SERVICE_URL=http://cart-service:3004
INVENTORY_SERVICE_URL=http://inventory-service:3005
ORDER_SERVICE_URL=http://order-service:3006
PAYMENT_SERVICE_URL=http://payment-service:3007
NOTIFICATION_SERVICE_URL=http://notification-service:3008

# ---- PostgreSQL Database URLs ----
AUTH_DATABASE_URL=postgres://postgres:password123@localhost:5432/auth_db
PRODUCT_DATABASE_URL=postgres://postgres:password123@localhost:5432/product_db
INVENTORY_DATABASE_URL=postgres://postgres:password123@localhost:5432/inventory_db
ORDER_DATABASE_URL=postgres://postgres:password123@localhost:5432/order_db
PAYMENT_DATABASE_URL=postgres://postgres:password123@localhost:5432/payment_db

# ---- Redis ----
REDIS_URL=redis://localhost:6379

# ---- RabbitMQ ----
RABBITMQ_URL=amqp://admin:admin123@localhost:5672/
RABBITMQ_USER=admin
RABBITMQ_PASSWORD=admin123
RABBITMQ_VHOST=/

# ---- Stripe ----
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here

# ---- Email / Notifications ----
RESEND_API_KEY=re_your_resend_api_key_here
FROM_EMAIL=noreply@example.com
FROM_NAME=MicroStore

# ---- CORS ----
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3003,http://localhost:3004,http://localhost:3005,http://localhost:3006,http://localhost:3007,http://localhost:3008
